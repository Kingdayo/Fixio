{
  "expo": {
    "name": "Fixio Mobile",
    "slug": "fixio-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fixio.mobile"
    },
    "android": {
      "package": "com.fixiomobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withIconBackground.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fixio needs access to your photos to attach screenshots to bug reports.",
          "cameraPermission": "Fixio needs camera access to take screenshots or record evidence of bugs."
        }
      ]
    ]
  }
}
